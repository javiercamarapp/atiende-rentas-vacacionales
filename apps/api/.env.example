# apps/api — variables de entorno documentadas (Lote 0, scaffold)
#
# Ninguna variable de este archivo lleva un valor real: es plantilla, no
# configuración. Copiar a `.env` (ignorado por git) y rellenar solo en un
# entorno de desarrollo local propio. Ningún valor aquí conecta a un canal
# real (Airbnb/Vrbo/Booking.com) ni a una base de datos productiva.

# Puerto HTTP del servidor Hono.
PORT=8787

# Entorno de ejecución: development | test | production.
#
# INVARIANTE (docs/auditoria-2/REVERIFICACION.md §3): NUNCA declares esta
# variable vacía ni con solo espacios (NODE_ENV="" o NODE_ENV="   ") en un
# despliegue real. Esa forma NO equivale a omitir la variable: el código
# distingue "ausente" (undefined, se trata como desarrollo local) de
# "definida pero vacía" (se trata como valor DESCONOCIDO, igual que un typo
# de "production" — fail-closed: la API aborta el arranque si faltan
# JWT_SECRET/CANAL_CIFRADO_CLAVES, y los simuladores de canal se niegan a
# arrancar). Si tu orquestador de despliegue solo sabe declarar variables
# vacías en vez de omitirlas, usa explícitamente "production" o define
# ATIENDE_ENTORNO/NODE_ENV con un valor real — nunca dejes esta línea vacía.
NODE_ENV=development

# Nombre del entorno mostrado en el healthcheck y en banners de UI — nunca
# "produccion" en un checkout de desarrollo (D-019, DEFINICION-DE-HECHO §1).
APP_ENV_LABEL=desarrollo

# Cadena de conexión a Postgres (embedded-postgres en Lote 1 en adelante).
# Vacía en Lote 0: no hay esquema de BD todavía.
DATABASE_URL=

# Secreto de firma de JWT propio (jose, D-009/D-020). Sin valor real aquí;
# se introduce en Lote 3 junto con auth/RLS.
JWT_SECRET=

# Origen permitido para CORS del frontend en desarrollo.
WEB_ORIGIN=http://localhost:5173

# Clave de cifrado AES-256-GCM de credenciales de canal (formato
# "v1:<32 bytes en base64>", ver KeyringCifradoCanal). OBLIGATORIA en
# cualquier entorno que no sea development/test explícito (S-02):
# el arranque ABORTA si falta. Generar con:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
CANAL_CIFRADO_CLAVES=

# Allow-list explícita (S-04, D-019) que decide si los simuladores de canal
# (SimuladorMensajeria, ServidorIcalSimulado, etc.) pueden arrancar en este
# proceso — SOLO "desarrollo" o "pruebas" lo permiten, independientemente
# de NODE_ENV. Cualquier otro valor (incluida cualquier variante mal
# escrita de "producción") bloquea el arranque del simulador. Sin esta
# variable, se usa NODE_ENV como respaldo (compatibilidad heredada).
ATIENDE_ENTORNO=desarrollo

# S-06: rate limit por IP+ruta (ventana fija en memoria, un solo proceso).
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_MAXIMO=100

# S-06: allow-list de IPs de proxy de confianza (balanceador/reverse proxy
# PROPIO) que pueden fijar X-Forwarded-For/X-Real-IP de forma confiable —
# separadas por coma. VACÍA por defecto: sin esta variable, el rate limit
# usa SIEMPRE la IP del socket TCP real, nunca una cabecera que el cliente
# controla. Solo configurar con las IPs exactas del proxy propio, nunca "*"
# ni la IP del propio cliente.
RATE_LIMIT_PROXIES_DE_CONFIANZA=

# S-06: límite adicional de intentos de POST /auth/login por email
# (normalizado), independiente del límite por IP — cierra fuerza bruta
# contra una sola cuenta desde muchas IPs/proxies distintos.
RATE_LIMIT_LOGIN_EMAIL_VENTANA_MS=900000
RATE_LIMIT_LOGIN_EMAIL_MAXIMO=20

# --- Lote 3.2 (H-096+): auth extendida — Google OIDC + cuenta local ---

# Google Sign-In (OpenID Connect, Authorization Code + PKCE). Sin las tres
# variables, el botón "Continuar con Google" aparece DESHABILITADO con
# motivo en la UI — nunca un error 500. Ver pasos exactos en Google Cloud
# Console en docs/despliegue/google-oauth.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Proveedor OIDC SIMULADO (emisor local con JWKS propio, para E2E sin
# depender de Google) — SOLO se monta si NODE_ENV es development/test
# explícito, sin importar este valor (fail-closed, D-019). Poner "false"
# para desactivarlo incluso en desarrollo.
ATIENDE_OIDC_SIMULADO=true

# SMTP para correos de verificación/restablecimiento de contraseña. Sin
# SMTP_HOST, se usa el adaptador de correo SIMULADO (nunca envía correo
# real, solo lo deja en el log con el prefijo "correo-simulado" — ver
# apps/api/src/seguridad/correo.ts) — es el valor por defecto recomendado
# para desarrollo/pruebas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@atiende.example

# Verificación opcional (k-anonymity, sin enviar la contraseña ni su hash
# completo) contra la API pública "Have I Been Pwned" — desactivada por
# defecto (depende de red externa, nunca debe bloquear pruebas/CI).
POLITICA_CONTRASENA_HIBP=false

# Bloqueo temporal de cuenta tras N intentos fallidos consecutivos de
# login (además del rate limit por IP+email de arriba).
BLOQUEO_CUENTA_MAX_INTENTOS=8
BLOQUEO_CUENTA_DURACION_MS=900000

# --- Sentry (monitoreo de errores, opcional — ver docs/despliegue/sentry.md) ---

# Sin esta variable, apps/api/src/observabilidad/sentry.ts NUNCA llama
# `Sentry.init` — no-op total, cero llamadas de red (D-017/D-019). Tomar
# el DSN del proyecto "Node" creado en Sentry.
SENTRY_DSN=

# Fracción de transacciones muestreadas (0.0–1.0). Baja por defecto
# (0.1 = 10%) — el tracing de Sentry no es gratis en volumen de requests.
SENTRY_TRACES_SAMPLE_RATE=0.1

# "true" para permitir que el correo del usuario viaje a Sentry en el
# evento (`user.email`) — por defecto (ausente/"false") se redacta antes
# de enviar cualquier evento (beforeSend), igual que cabeceras
# authorization/cookie y cualquier campo con forma de secreto.
SENTRY_SEND_PII=false
