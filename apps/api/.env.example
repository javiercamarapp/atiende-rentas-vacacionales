# apps/api — variables de entorno documentadas (Lote 0, scaffold)
#
# Ninguna variable de este archivo lleva un valor real: es plantilla, no
# configuración. Copiar a `.env` (ignorado por git) y rellenar solo en un
# entorno de desarrollo local propio. Ningún valor aquí conecta a un canal
# real (Airbnb/Vrbo/Booking.com) ni a una base de datos productiva.

# Puerto HTTP del servidor Hono.
PORT=8787

# Entorno de ejecución: development | test | production.
NODE_ENV=development

# Nombre del entorno mostrado en el healthcheck y en banners de UI — nunca
# "produccion" en un checkout de desarrollo (D-019, DEFINICION-DE-HECHO §1).
APP_ENV_LABEL=desarrollo

# Cadena de conexión a Postgres (embedded-postgres en Lote 1 en adelante).
# Vacía en Lote 0: no hay esquema de BD todavía.
DATABASE_URL=

# Secreto de firma de JWT propio (jose, D-009/D-020). Sin valor real aquí;
# se introduce en Lote 3 junto con auth/RLS.
JWT_SECRET=

# Origen permitido para CORS del frontend en desarrollo.
WEB_ORIGIN=http://localhost:5173

# Clave de cifrado AES-256-GCM de credenciales de canal (formato
# "v1:<32 bytes en base64>", ver KeyringCifradoCanal). OBLIGATORIA en
# cualquier entorno que no sea development/test explícito (S-02):
# el arranque ABORTA si falta. Generar con:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
CANAL_CIFRADO_CLAVES=

# Allow-list explícita (S-04, D-019) que decide si los simuladores de canal
# (SimuladorMensajeria, ServidorIcalSimulado, etc.) pueden arrancar en este
# proceso — SOLO "desarrollo" o "pruebas" lo permiten, independientemente
# de NODE_ENV. Cualquier otro valor (incluida cualquier variante mal
# escrita de "producción") bloquea el arranque del simulador. Sin esta
# variable, se usa NODE_ENV como respaldo (compatibilidad heredada).
ATIENDE_ENTORNO=desarrollo
