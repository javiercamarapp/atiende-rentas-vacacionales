# Plantilla para `deploy/docker-compose.yml` (VPS/Docker, alternativa a
# Vercel — Lote 3.3). Copiar a `deploy/.env.docker` (ignorado por git,
# nunca commitear valores reales) y rellenar.
#
#   cp deploy/.env.docker.example deploy/.env.docker
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env.docker up -d --build

POSTGRES_DB=atiende_rv
POSTGRES_USER=atiende_rv_admin
# Genera una contraseña fuerte propia — nunca reutilices esta plantilla.
POSTGRES_PASSWORD=

# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Genera con: node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
CANAL_CIFRADO_CLAVES=

APP_ENV_LABEL=produccion

# Dominio público real del VPS (o IP:puerto en pruebas) — usado para CORS
# y para componer URLs absolutas (feed .ics, links de correo).
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080/api

# Opcionales — vacíos por defecto (fail-closed): sin estas variables, el
# botón de Google aparece deshabilitado y los correos usan el adaptador
# simulado (ver apps/api/.env.example para la explicación completa de
# cada una).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@atiende.example

# Stripe (Lote 3.3, facturación) — sin estas dos variables, la API usa
# ÚNICAMENTE el adaptador `PagosSimulado` (nunca llama a Stripe real).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
