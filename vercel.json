{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "VITE_API_URL=/api npm run build --workspace=@atiende-rv/web && npm run build:api-vercel",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/cron/sync-ical", "schedule": "*/15 * * * *" },
    { "path": "/api/internal/cron/webhooks-retry", "schedule": "*/5 * * * *" },
    { "path": "/api/internal/cron/limpieza-checkout", "schedule": "*/15 * * * *" },
    { "path": "/api/internal/cron/outbox-worker", "schedule": "*/10 * * * *" }
  ]
}
